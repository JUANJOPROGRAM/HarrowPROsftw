<Window x:Class="HarrowStudio.Desktop.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Crear macro" Height="610" Width="580" MinHeight="440" MinWidth="420" MaxWidth="760"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#070809" Foreground="#F5F5F7" FontFamily="Segoe UI Variable Display, Segoe UI" Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="#090A0C" BorderBrush="#282A30" BorderThickness="1" CornerRadius="12">
  <Grid x:Name="DialogRoot" Background="#070809" Opacity="0" RenderTransformOrigin=".5,.5" Margin="1">
    <Grid.RenderTransform><ScaleTransform ScaleX=".985" ScaleY=".985"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#090A0C" BorderBrush="#1D1F23" BorderThickness="0,0,0,1" shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#E74756" Margin="0,0,8,0"/><TextBlock Text="HARROW STUDIO" FontSize="11" FontWeight="Bold"/><TextBlock Text="  /  EDITOR DE MACROS" Foreground="#94979E" FontSize="11" Margin="4,0,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Width="38" Background="Transparent" Foreground="#94979E" BorderThickness="0" FontSize="17" Cursor="Hand" Click="Cancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></Grid>
    </Border>
    <Grid Grid.Row="1" Margin="25,20,25,24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="EDITOR DE MACROS" FontSize="11" FontWeight="SemiBold" Foreground="#E74756"/><TextBlock Text="Crea una secuencia" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Añade pulsaciones en el orden en que deben ejecutarse." Foreground="#94979E" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="NOMBRE DE LA MACRO" FontSize="11" FontWeight="SemiBold" Foreground="#94979E" Margin="0,0,0,7"/><TextBox Style="{StaticResource DarkTextBox}" x:Name="NameBox" Text="Nueva macro" FontSize="13"/></StackPanel>
      <Border Grid.Row="2" Background="#101114" BorderBrush="#24262B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width=".8*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BOTÓN" FontSize="11" Foreground="#94979E" Margin="0,0,0,6"/><ComboBox Style="{StaticResource DarkComboBox}" x:Name="ButtonBox" Height="32"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="PULSACIÓN ms" FontSize="11" Foreground="#94979E" Margin="0,0,0,6"/><TextBox Style="{StaticResource DarkTextBox}" x:Name="DurationBox" Text="80" FontSize="12"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="ESPERA ms" FontSize="11" Foreground="#94979E" Margin="0,0,0,6"/><TextBox Style="{StaticResource DarkTextBox}" x:Name="DelayBox" Text="40" FontSize="12"/></StackPanel><Button Grid.Column="3" Content="＋" Width="34" Height="32" Margin="8,18,0,0" Background="#E74756" Foreground="White" BorderThickness="0" FontSize="17" FontWeight="Bold" Cursor="Hand" Click="AddStep_Click"/></Grid>
      </Border>
      <StackPanel Grid.Row="3" Margin="0,15,0,0"><Grid Margin="1,0,1,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PASOS" FontSize="11" FontWeight="SemiBold" Foreground="#94979E"/><TextBlock x:Name="StepCount" Grid.Column="1" Text="0 pasos" FontSize="11" Foreground="#94979E"/></Grid><ListBox x:Name="StepList" Background="#101114" BorderBrush="#24262B" Foreground="#F5F5F7" BorderThickness="1" Padding="6"><ListBox.ItemTemplate><DataTemplate><Border Padding="7,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="7" Background="#30171B"><TextBlock Text="{Binding Button}" Foreground="#E74756" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Text="Pulsar durante " FontSize="12"/><TextBlock Text="{Binding DurationMs, StringFormat={}{0} ms}" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DelayMs, StringFormat=+ {0} ms}" Foreground="#94979E" FontSize="11" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
      <Grid Grid.Row="4" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ErrorLabel" Foreground="#F09082" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Cancelar" Padding="12,8" Margin="0,0,8,0" Background="#1A1B20" Foreground="#F5F5F7" BorderThickness="0" Cursor="Hand" Click="Cancel_Click"/><Button Grid.Column="2" Content="Guardar macro" Padding="13,8" Background="#E74756" Foreground="White" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Save_Click"/></Grid>
    </Grid>
  </Grid>
  </Border>
</Window>
