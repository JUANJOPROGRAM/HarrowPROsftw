<Window x:Class="HarrowStudio.Desktop.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desinstalar Harrow Studio" Width="620" Height="460" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource Accent}" Margin="0,0,13,0">
        <TextBlock Text="H" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="HARROW STUDIO" FontSize="13" FontWeight="Bold" />
        <TextBlock Text="ASISTENTE DE DESINSTALACIÓN" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,25,0,0">
      <TextBlock Text="¿Quieres desinstalar Harrow Studio?" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="Se quitarán la aplicación y sus accesos directos de este equipo." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,22,0,0">
      <TextBlock Text="CARPETA DE INSTALACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" />
      <TextBox x:Name="InstallPathBox" IsReadOnly="True" />
    </StackPanel>

    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="i" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,10,0" />
        <TextBlock Text="Tus perfiles, macros y asignaciones guardados se conservarán." FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,18">
      <ProgressBar x:Name="UninstallProgress" Height="4" IsIndeterminate="False" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Text="La desinstalación eliminará la aplicación y sus accesos directos." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="5">
      <TextBlock Text="HARROW STUDIO · 0.1.1" Foreground="#777A82" FontSize="11" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="Cancelar" MinWidth="105" Margin="0,0,8,0" Background="#202126" Click="Cancel_Click" />
        <Button x:Name="UninstallButton" Content="Desinstalar" MinWidth="130" Click="Uninstall_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
