<Application x:Class="HarrowStudio.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="SetupWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#070809" />
    <SolidColorBrush x:Key="Panel" Color="#111215" />
    <SolidColorBrush x:Key="Line" Color="#27292E" />
    <SolidColorBrush x:Key="Primary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="Secondary" Color="#A5A8AF" />
    <SolidColorBrush x:Key="Accent" Color="#E74756" />
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#17191D" />
      <Setter Property="Foreground" Value="{StaticResource Primary}" />
      <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="#32343A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
