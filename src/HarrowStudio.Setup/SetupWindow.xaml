<Window x:Class="HarrowStudio.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar Harrow Studio" Width="620" Height="460" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Primary}" FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource Accent}" Margin="0,0,13,0">
        <TextBlock Text="H" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="HARROW STUDIO" FontSize="13" FontWeight="Bold" />
        <TextBlock Text="INSTALADOR PARA WINDOWS" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,25,0,0">
      <TextBlock Text="Configura tu espacio de juego" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Instala la aplicación y sus componentes en este equipo." FontSize="13" Foreground="{StaticResource Secondary}" Margin="0,7,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,22,0,0">
      <TextBlock Text="CARPETA DE INSTALACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" Margin="0,0,0,8" />
      <TextBox x:Name="InstallPathBox" />
    </StackPanel>

    <CheckBox x:Name="DesktopShortcutCheckBox" Grid.Row="3" Content="Crear un icono de Harrow Studio en el escritorio" IsChecked="True" Foreground="{StaticResource Primary}" FontSize="13" Margin="0,20,0,0" VerticalAlignment="Top" />

    <StackPanel Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,18">
      <ProgressBar x:Name="InstallProgress" Height="4" IsIndeterminate="False" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Text="La instalación es solo para tu usuario y no requiere privilegios de administrador." FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="5">
      <TextBlock Text="HARROW STUDIO · 0.1.1" Foreground="#777A82" FontSize="11" VerticalAlignment="Center" />
      <Button x:Name="InstallButton" Content="Instalar" HorizontalAlignment="Right" MinWidth="130" Click="Install_Click" />
    </Grid>
  </Grid>
</Window>
